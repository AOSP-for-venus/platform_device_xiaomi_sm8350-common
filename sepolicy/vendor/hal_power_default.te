type vendor_sysfs_sde_crtc, fs_type, sysfs_type;
type vendor_touchfeature_device, dev_type;

allow hal_power_default cgroup:file r_file_perms;
allow hal_power_default vendor_touchfeature_device:chr_file rw_file_perms;
allow hal_power_default vendor_latency_device:chr_file rw_file_perms;

# Set scheduling info for apps (for adpf)
allow hal_power_default appdomain:process { getsched setsched };
allow hal_power_default appdomain:process setsched;
allow hal_power_default platform_app:process { getsched setsched };
allow hal_power_default priv_app:process { getsched setsched };
allow hal_power_default priv_app:process setsched;
allow hal_power_default untrusted_app:process { getsched setsched };

allow hal_power_default self:capability sys_nice;

# Set scheduling info for surfaceflinger (for adpf)
allow hal_power_default surfaceflinger:process setsched;

# Set scheduling info for HWC (for adpf)
allow hal_power_default hal_graphics_composer_default:process setsched;

# Set scheduling info for system_server (for adpf)
allow hal_power_default system_server:process setsched;

allow hal_power_default powerhal_vendor_data_file:dir rw_dir_perms;
allow hal_power_default powerhal_vendor_data_file:file create_file_perms;

rw_dir_file(hal_power_default, proc)
rw_dir_file(hal_power_default, proc_sched)
rw_dir_file(hal_power_default, sysfs_devices_system_cpu)
rw_dir_file(hal_power_default, vendor_sysfs_devfreq)
rw_dir_file(hal_power_default, vendor_sysfs_graphics)
rw_dir_file(hal_power_default, vendor_sysfs_kgsl)
rw_dir_file(hal_power_default, vendor_sysfs_msm_perf)
rw_dir_file(hal_power_default, vendor_sysfs_scsi_host)
rw_dir_file(hal_power_default, vendor_sysfs_sde_crtc)

set_prop(hal_power_default, vendor_power_prop)
